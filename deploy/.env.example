# Non-secret production settings. The startup helper creates protected Compose secret files.
HERMES_IMAGE=ghcr.io/mrcoggsworth/threat-intel-agent:v0.1.0
HERMES_COMPOSE_FILE=deploy/docker-compose.yml
HERMES_SECRET_DIR=${HOME}/.local/state/cti-hermes/secrets
# Host Nginx owns ports 80/443. Hermes is published only on loopback for the
# host-level reverse proxy.
HERMES_WEB_BIND_ADDRESS=127.0.0.1
HERMES_WEB_PORT=18000
HERMES_PRIVATE_HOST=ops.cti-hermes.home.arpa
HERMES_BACKUP_RETENTION_DAYS=14
HERMES_DISK_USED_FRACTION=0.85
# The deployment script requires HERMES_DEPLOY_APPROVED=true and an approval reference.

# Analyst cron calls this API surface through host Nginx.
HERMES_ANALYST_SERVICE_URL=https://matrix-1.taild27e3c.ts.net:9443
