# CTI-Hermes internal application.
# Host Nginx owns TLS and forwards to the loopback-only Compose web port.

upstream cti_hermes_web {
    server 127.0.0.1:18000;
}

server {
    listen 100.68.61.10:9443 ssl;
    server_name matrix-1.taild27e3c.ts.net;

    ssl_certificate /etc/nginx/ssl/tailscale/hermes.crt;
    ssl_certificate_key /etc/nginx/ssl/tailscale/hermes.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    allow 100.64.0.0/10;
    allow 127.0.0.1/32;
    deny all;

    # Port 9443 is the public portal plus authenticated analyst API.
    # Keep readiness, version, admin, and operations data on the private port.
    location ~ ^/(health/ready|version|api/v1/(admin|ops)(/|$)) {
        return 404;
    }

    # Hermes analyst cron uses this authenticated API on the 9443 surface.
    location ~ ^/api/v1/analyst(/|$) {
        proxy_pass http://cti_hermes_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://cti_hermes_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 100.68.61.10:9444 ssl;
    server_name matrix-1.taild27e3c.ts.net;

    ssl_certificate /etc/nginx/ssl/tailscale/hermes.crt;
    ssl_certificate_key /etc/nginx/ssl/tailscale/hermes.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    allow 100.64.0.0/10;
    allow 127.0.0.1/32;
    deny all;

    # The application still requires X-Admin-Token. Nginx supplies the
    # private-host identity used by the internal operations path.
    location ~ ^/(health/ready|version|api/v1/(admin|ops)(/|$)) {
        proxy_pass http://cti_hermes_web;
        proxy_http_version 1.1;
        proxy_set_header Host ops.cti-hermes.home.arpa;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
