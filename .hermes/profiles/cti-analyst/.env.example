# Safe staging template only. Copy to the dedicated runtime Hermes home as
# .env and fill values through the host secret-management process. Never add
# tokens, passwords, database URLs, or private keys to this repository.
HERMES_PROFILE=cti-analyst
ABSOLUTE_REPOSITORY_PATH=/home/$USER/code/threat-intel-agent/
PRIVATE_SERVICE_URL=https://ops.cti-hermes.local
HERMES_PRIVATE_SERVICE_URL=https://ops.cti-hermes.local
HERMES_MODEL=__SET_AND_PIN_MODEL__
HERMES_PROVIDER=__SET_AND_PIN_PROVIDER__
HERMES_ANALYST_SERVICE_TOKEN_FILE=/etc/hermes/cti-analyst/service-token
HERMES_ANALYST_OUTPUT_DIR=/home/$USER/code/threat-intel-agent/portal/analyst-output
HERMES_CRON_HEALTH_INTERVAL='*/5 * * * *'
