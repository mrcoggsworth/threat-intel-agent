# Safe staging template only. Copy to the dedicated runtime Hermes home as
# .env and fill values through the host secret-management process. Never add
# tokens, passwords, database URLs, or private keys to this repository.
HERMES_PROFILE=cti-maintainer
ABSOLUTE_REPOSITORY_PATH=/home/$USER/code/threat-intel-agent/
PRIVATE_SERVICE_URL=https://ops.cti-hermes.home.arpa
HERMES_PRIVATE_SERVICE_URL=https://ops.cti-hermes.home.arpa
HERMES_MODEL=__SET_AND_PIN_MODEL__
HERMES_PROVIDER=__SET_AND_PIN_PROVIDER__
HERMES_MAINTAINER_TOKEN_FILE=/etc/hermes/cti-maintainer/admin-token
HERMES_PUBLIC_BASE_URL=https://cti-hermes.local
HERMES_BACKUP_METADATA_FILE=/var/lib/cti-hermes/backups/latest.metadata
HERMES_HEARTBEAT_FILE=/var/lib/cti-hermes/runtime/scheduler.heartbeat
HERMES_CERT_FILE=/var/lib/cti-hermes/tls/fullchain.pem
HERMES_POSTGRES_CONTAINER=cti-hermes-postgres-1
HERMES_BACKUP_MAX_AGE_SECONDS=172800
HERMES_HEARTBEAT_MAX_AGE_SECONDS=120
HERMES_DISK_USED_FRACTION=0.85
HERMES_CERT_MIN_REMAINING_SECONDS=1209600
HERMES_COMPOSE_FILE=deploy/docker-compose.yml
HERMES_PRODUCTION_ENV_FILE=/opt/cti-hermes/env/production.env
HERMES_APPROVAL_REFERENCE=__REQUIRED_PER_APPROVED_OPERATION__
HERMES_DEPLOY_APPROVED=false
HERMES_HEALTH_INTERVAL='*/5 * * * *'
